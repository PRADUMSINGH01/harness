# Copy to .env and fill in what you use. Names match agent/.env, so the same keys work in both.

# Z.ai GLM (OpenAI-compatible)
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/paas/v4/
ZAI_MODEL=glm-5.3-flash
# Required only to judge with Z.ai: a GLM model that accepts images.
ZAI_VISION_MODEL=

# Gemini (OpenAI-compatible endpoint)
GEMINI_API_KEY=
GEMINI_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-3.1-flash-lite
# Optional: a stronger model for judging only.
GEMINI_VISION_MODEL=

# Qwen via DashScope (OpenAI-compatible)
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=
DASHSCOPE_VISION_MODEL=

# Any other OpenAI-compatible endpoint
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
OPENAI_VISION_MODEL=

# Claude Agent SDK builder/judge (optional)
ANTHROPIC_API_KEY=

# Defaults when POST /runs omits builder/judge. Build and judge on different providers to avoid self-preference.
HARNESS_BUILDER=zai
HARNESS_JUDGE=gemini

# Server (Docker or npm run server)
# Require this key on every route except /health and /docs (header x-api-key, Bearer token, or ?key= once in a browser).
HARNESS_API_KEY=
# The address clients reach the server at; links in API responses use it.
HARNESS_PUBLIC_URL=http://localhost:8100
# Docker only: the host port the container is published on.
HARNESS_HOST_PORT=8100
